# Variables para Netlify (Site settings → Environment variables) o archivo .env con `npm run start:api`

# --- Recomendado: Green API (envía desde el WhatsApp del taller, ej. 3213622399) ---
# 1. Regístrate en https://green-api.com
# 2. Crea una instancia y escanea el QR con el WhatsApp del taller
# 3. Copia idInstance y apiTokenInstance aquí:

# apiUrl de tu panel Green API (sin barra final)
GREEN_API_HOST=https://7107.api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_API_TOKEN=

# --- Alternativa: Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
